programa {
    funcao inicio() {
        inteiro n1 = 0
        inteiro n2 = 0
        escreva("Número 1: ")
            leia(n1)
        escreva("Número 2: ")
            leia(n2)
        escreva("Adição: " + (n1 + n2))
        escreva("\nSubtração: " + (n1 - n2))
        escreva("\nMultiplicação: " + (n1 * n2))
        escreva("\nDivisão: " + (n1 / n2))
    }
}
